---
import Layout from '../layouts/Layout.astro';

if (Astro.locals.user) {
	return Astro.redirect('/dashboard');
}

const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success');
---

<Layout title="Registro | Cuoting">
	<div class="mb-6 pt-4 text-center">
		<h1 class="text-3xl font-bold text-[#0F2C59]">Cuoting</h1>
		<p class="text-sm font-medium text-[#1A1A1A]/60">Claridad financiera en cuotas</p>
	</div>
	<section class="mx-auto max-w-md space-y-6 rounded-lg bg-white p-8 shadow-sm">
		<h2 class="text-xl font-semibold text-[#1A1A1A]">Creá tu cuenta</h2>

		{error && <p class="rounded-md bg-red-50 p-3 text-sm text-red-700">{error}</p>}
		{success && <p class="rounded-md bg-emerald-50 p-3 text-sm text-emerald-700">{success}</p>}

		<form method="post" action="/api/auth/register" class="space-y-4">
			<label class="block space-y-1">
				<span class="text-sm font-medium text-[#1A1A1A]/70">Email</span>
				<input type="email" name="email" required class="w-full" />
			</label>
			<label class="block space-y-1">
				<span class="text-sm font-medium text-[#1A1A1A]/70">Contraseña</span>
				<input type="password" name="password" minlength="8" required class="w-full" />
			</label>
			<label class="block space-y-1">
				<span class="text-sm font-medium text-[#1A1A1A]/70">Confirmá tu contraseña</span>
				<input type="password" name="confirmPassword" minlength="8" required class="w-full" />
			</label>
			<button type="submit" class="w-full cursor-pointer rounded-lg bg-[#DF9F28] px-5 py-2.5 text-sm font-semibold text-[#0F2C59] hover:bg-[#C88A1E]">Crear cuenta</button>
		</form>

		<p class="text-sm font-medium text-[#1A1A1A]/60">
			¿Ya tenés cuenta?
			<a class="font-semibold text-[#0F2C59] hover:text-[#1A3A6B] underline" href="/login">Ingresá acá</a>
		</p>
	</section>
</Layout>
